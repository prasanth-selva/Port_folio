@@ -22,8 +25,30 @@ const sb = createClient(url, serviceKey, {
 // Inline canonical seed (mirrors src/lib/seed-data.ts to avoid a TS build step).
 const seed = JSON.parse(readFileSync(new URL("../seed.json", import.meta.url), "utf8"));
 
+const FORCE = process.argv.includes("--force");
+const UUID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
+
+/** seed.json uses readable ids ("seed-linux"); the DB columns are uuid. Map them deterministically so re-seeding is idempotent. */
+function toUuid(id) {
+  if (UUID_RE.test(id)) return id;
+  const h = createHash("sha1").update(`portfolio-seed:${id}`).digest("hex");
+  const variant = ((parseInt(h.slice(16, 18), 16) & 0x3f) | 0x80).toString(16).padStart(2, "0");
+  return `${h.slice(0, 8)}-${h.slice(8, 12)}-5${h.slice(13, 16)}-${variant}${h.slice(18, 20)}-${h.slice(20, 32)}`;
+}
+
+async function isPopulated(table) {
+  const { count, error } = await sb.from(table).select("*", { count: "exact", head: true });
+  if (error) throw new Error(`${table}: ${error.message}`);
+  return (count ?? 0) > 0;
+}
+
 async function upsertAll(table, rows, conflict) {
   if (!rows?.length) return;
+  if (!FORCE && (await isPopulated(table))) {
+    console.log(`- ${table}: already has data, skipped (use --force to overwrite)`);
+    return;
+  }
+  rows = rows.map((r) => (r.id ? { ...r, id: toUuid(r.id) } : r));
   const { error } = await sb.from(table).upsert(rows, { onConflict: conflict });
   if (error) {
     console.error(`✗ ${table}: ${error.message}`);
@@ -40,10 +65,10 @@ await upsertAll("achievements", seed.achievements, "id");
 await upsertAll("skills", seed.skills, "id");
 await upsertAll("posts", seed.posts, "slug");
 
-const settingsRows = Object.entries(seed.settings).map(([key, value]) => ({
-  key,
-  value,
-}));
+// settings.value is NOT NULL jsonb; null entries mean "use the built-in default", so skip them.
+const settingsRows = Object.entries(seed.settings)
+  .filter(([, value]) => value !== null && value !== undefined)
+  .map(([key, value]) => ({ key, value }));
 await upsertAll("settings", settingsRows, "key");
 
 console.log("Seed complete.");
