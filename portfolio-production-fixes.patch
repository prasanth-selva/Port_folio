+-- Hardening: the contact form writes through the server (/api/contact) with the
+-- service-role key, after validation, honeypot and rate limiting. Remove the
+-- anonymous INSERT policy so nobody can bypass those checks by calling the
+-- Supabase REST API directly with the public anon key.
+drop policy if exists "public can submit messages" on public.messages;
+
+-- Defence in depth: the browser never needs write access to content tables.
+revoke insert, update, delete on
+  public.projects, public.experiences, public.certifications,
+  public.achievements, public.skills, public.posts, public.settings, public.messages
+from anon;
