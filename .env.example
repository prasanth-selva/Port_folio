# ── Site ────────────────────────────────────────────────────────────────────
# Canonical URL (used for metadata, sitemap, robots, OG images)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: show a contact phone number (leave empty to hide)
NEXT_PUBLIC_CONTACT_PHONE=

# Optional: extra image hosts allowed by next/image + CSP (comma-separated)
NEXT_PUBLIC_IMAGE_HOSTS=

# ── Supabase ───────────────────────────────────────────────────────────────
# Project URL (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
# Public anon key (public reads via RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — SERVER ONLY, bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ── Admin auth (NextAuth) ──────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Canonical admin URL for NextAuth (your production domain)
NEXTAUTH_URL=http://localhost:3000
# Single admin account
ADMIN_EMAIL=admin@example.com
# Either set ADMIN_PASSWORD (simple) or ADMIN_PASSWORD_HASH (preferred):
#   generate a hash: node -e "console.log(require('bcryptjs').hashSync('YOUR_PASSWORD',12))"
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=

# ── Contact form email notifications (optional) ────────────────────────────
RESEND_API_KEY=
CONTACT_NOTIFY_EMAIL=
RESEND_FROM="Portfolio <onboarding@resend.dev>"
